{
  "io": {
    "input_directory": "data/stl",
    "output_directory": "data/stl_processed",
    "glob": "*.stl"
  },
  "runtime": {
    "per_file_timeout_sec": 3.0,
    "max_workers": 20
  },
  "repair": {
    "close_holes_max_size": 1000
  },
  "remesh": {
    "enabled": false,
    "iterations": 4,
    "target_perc": 1.0
  }
}
